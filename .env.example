# Скопируйте в .env и замените значения. Файл .env в репозиторий не попадает.
# В паролях используйте только латинские буквы и цифры: они подставляются в адрес базы.

# Пароль роли-владельца базы (миграции, администрирование).
POSTGRES_PASSWORD=change-me-owner-password

# Пароль роли, под которой работает сервер. Не меньше 16 символов.
APP_DB_PASSWORD=change-me-app-password

# Ключ подписи токенов. Не меньше 32 символов; сгенерировать: openssl rand -hex 32
JWT_SECRET=change-me-generate-a-long-random-string

# Адреса сайта, которому разрешены запросы из браузера, через запятую.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# true — когда сервер стоит за обратным прокси (этап деплоя).
TRUST_PROXY=false
