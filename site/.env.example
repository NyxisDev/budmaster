# Скопіюйте в .env.local і задайте свої значення.

# false — каталог береться із сервера; інакше — з демонстраційних даних.
VITE_USE_MOCKS=false
# Адреса сервера Budmaster.
VITE_API_URL=http://127.0.0.1:8080
# true — заявки йдуть на сервер (з етапу 5 плану). Поки false: заявки демонстраційні.
VITE_ORDERS_LIVE=false
